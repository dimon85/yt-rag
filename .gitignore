# Raw transcripts and embedding caches — fetched once, never committed.
# No trailing slash: a git worktree has no cache of its own and gets one as a
# symlink into the main checkout, and `cache/` matches a directory only.
cache

# Node
node_modules/
dist/
*.tsbuildinfo

# Env / secrets
.env
.env.*
!.env.example

# Logs, run artifacts
*.log
runs/

# OS
.DS_Store

# Ukrainian-language source copies — kept locally, not published
*_ua.md
*_ua.yaml

# Personal working plan — session schedule, time budget, cut list
docs/plan.md

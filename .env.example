# Hosted embedding model. The free tier is NOT enough for this corpus: the
# allowance is spent per TEXT against a daily cap of roughly a thousand, and
# the corpus is 3,238 chunks at 128 tokens. See docs/spec.md.
GEMINI_API_KEY=

# Embeddings through OpenRouter, billed per token rather than capped per day.
# The whole matrix is about 3.2M tokens — a few cents through baai/bge-m3.
# Nothing is spent without --spend-embed.
#   pnpm eval --embedder openrouter --spend-embed --run-all
# The key can stay out of this file entirely:
#   OPENROUTER_API_KEY=$(security find-generic-password -a "$USER" -s openrouter -w) pnpm eval ...
OPENROUTER_API_KEY=

# Cohere Rerank. Nothing is spent without --spend-rerank.
COHERE_API_KEY=
